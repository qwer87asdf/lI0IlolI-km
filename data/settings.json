      "en": {
        "whyThisAdButtonText": "Why is this ad shown?",
        "closeAdButtonText": "Close Ad, buy premium",
        "whyThisAdTitle": "Why are ads shown in the Muslims Day app?",
        "whyThisAdDescription": "<p>The regular development of the Muslims Day app costs a significant amount of money each month. A portion of this cost is covered by showing halal advertisements in the app.</p><p>However, you can easily get an ad-free app by clicking the <strong>button below</strong>. This will help us to continue our operations.</p>",
        "buySubscriptionButtonText": "Buy Premium Subscription",
        "closeButtonText": "Okay, I understand"
      }
    }

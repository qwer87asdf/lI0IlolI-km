{
  "schemaVersion": 1,
  "eventType": "RAMADAN_START",
  "language": "ar",
  "items": [
    {
      "id": "q-2-152",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة البقرة ٢:١٥٢",
      "surah": 2,
      "ayah": 152
    },
    {
      "id": "q-2-153",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة البقرة ٢:١٥٣",
      "surah": 2,
      "ayah": 153
    },
    {
      "id": "q-2-183",
      "type": "verse",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة البقرة ٢:١٨٣",
      "surah": 2,
      "ayah": 183
    },
    {
      "id": "q-2-185",
      "type": "verse",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "شَهْرُ رَمَضَانَ الَّذِي أُنزِلَ فِيهِ الْقُرْآنُ هُدًى لِّلنَّاسِ وَبَيِّنَاتٍ مِّنَ الْهُدَىٰ وَالْفُرْقَانِ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة البقرة ٢:١٨٥",
      "surah": 2,
      "ayah": 185
    },
    {
      "id": "q-2-186",
      "type": "verse",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة البقرة ٢:١٨٦",
      "surah": 2,
      "ayah": 186
    },
    {
      "id": "q-2-201",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة البقرة ٢:٢٠١",
      "surah": 2,
      "ayah": 201
    },
    {
      "id": "q-2-286",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة البقرة ٢:٢٨٦",
      "surah": 2,
      "ayah": 286
    },
    {
      "id": "q-3-8",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِن لَّدُنكَ رَحْمَةً ۚ إِنَّكَ أَنتَ الْوَهَّابُ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة آل عمران ٣:٨",
      "surah": 3,
      "ayah": 8
    },
    {
      "id": "q-3-31",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "قُلْ إِن كُنتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ ۗ وَاللَّهُ غَفُورٌ رَّحِيمٌ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة آل عمران ٣:٣١",
      "surah": 3,
      "ayah": 31
    },
    {
      "id": "q-3-133",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "وَسَارِعُوا إِلَىٰ مَغْفِرَةٍ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا السَّمَاوَاتُ وَالْأَرْضُ أُعِدَّتْ لِلْمُتَّقِينَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة آل عمران ٣:١٣٣",
      "surah": 3,
      "ayah": 133
    },
    {
      "id": "q-3-139",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنتُمُ الْأَعْلَوْنَ إِن كُنتُم مُّؤْمِنِينَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة آل عمران ٣:١٣٩",
      "surah": 3,
      "ayah": 139
    },
    {
      "id": "q-7-56",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "وَادْعُوهُ خَوْفًا وَطَمَعًا ۚ إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِّنَ الْمُحْسِنِينَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الأعراف ٧:٥٦",
      "surah": 7,
      "ayah": 56
    },
    {
      "id": "q-9-40",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة التوبة ٩:٤٠",
      "surah": 9,
      "ayah": 40
    },
    {
      "id": "q-12-87",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "وَلَا تَيْأَسُوا مِن رَّوْحِ اللَّهِ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة يوسف ١٢:٨٧",
      "surah": 12,
      "ayah": 87
    },
    {
      "id": "q-13-28",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "الَّذِينَ آمَنُوا وَتَطْمَئِنُّ قُلُوبُهُم بِذِكْرِ اللَّهِ ۗ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الرعد ١٣:٢٨",
      "surah": 13,
      "ayah": 28
    },
    {
      "id": "q-14-7",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "وَإِذْ تَأَذَّنَ رَبُّكُمْ لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة إبراهيم ١٤:٧",
      "surah": 14,
      "ayah": 7
    },
    {
      "id": "q-15-49",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الحجر ١٥:٤٩",
      "surah": 15,
      "ayah": 49
    },
    {
      "id": "q-16-128",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "إِنَّ اللَّهَ مَعَ الَّذِينَ اتَّقَوا وَّالَّذِينَ هُم مُّحْسِنُونَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة النحل ١٦:١٢٨",
      "surah": 16,
      "ayah": 128
    },
    {
      "id": "q-20-25",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "رَبِّ اشْرَحْ لِي صَدْرِي وَيَسِّرْ لِي أَمْرِي",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة طه ٢٠:٢٥–٢٦",
      "surah": 20,
      "ayah": 25
    },
    {
      "id": "q-20-46",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "لَا تَخَافَا ۖ إِنَّنِي مَعَكُمَا أَسْمَعُ وَأَرَىٰ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة طه ٢٠:٤٦",
      "surah": 20,
      "ayah": 46
    },
    {
      "id": "q-21-87",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "لَا إِلَٰهَ إِلَّا أَنتَ سُبْحَانَكَ إِنِّي كُنتُ مِنَ الظَّالِمِينَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الأنبياء ٢١:٨٧",
      "surah": 21,
      "ayah": 87
    },
    {
      "id": "q-25-70",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "إِلَّا مَن تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَٰئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ ۗ وَكَانَ اللَّهُ غَفُورًا رَّحِيمًا",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الفرقان ٢٥:٧٠",
      "surah": 25,
      "ayah": 70
    },
    {
      "id": "q-29-69",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا ۚ وَإِنَّ اللَّهَ لَمَعَ الْمُحْسِنِينَ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة العنكبوت ٢٩:٦٩",
      "surah": 29,
      "ayah": 69
    },
    {
      "id": "q-39-53",
      "type": "verse",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنفُسِهِمْ لَا تَقْنَطُوا مِن رَّحْمَةِ اللَّهِ ۚ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا ۚ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الزمر ٣٩:٥٣",
      "surah": 39,
      "ayah": 53
    },
    {
      "id": "q-40-60",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة غافر ٤٠:٦٠",
      "surah": 40,
      "ayah": 60
    },
    {
      "id": "q-50-16",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "وَلَقَدْ خَلَقْنَا الْإِنسَانَ وَنَعْلَمُ مَا تُوَسْوِسُ بِهِ نَفْسُهُ ۖ وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة ق ٥٠:١٦",
      "surah": 50,
      "ayah": 16
    },
    {
      "id": "q-57-16",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا أَن تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ اللَّهِ وَمَا نَزَلَ مِنَ الْحَقِّ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الحديد ٥٧:١٦",
      "surah": 57,
      "ayah": 16
    },
    {
      "id": "q-65-3",
      "type": "verse",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الطلاق ٦٥:٣",
      "surah": 65,
      "ayah": 3
    },
    {
      "id": "q-89-27",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "يَا أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ ارْجِعِي إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الفجر ٨٩:٢٧–٢٨",
      "surah": 89,
      "ayah": 27
    },
    {
      "id": "q-93-3",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الضحى ٩٣:٣",
      "surah": 93,
      "ayah": 3
    },
    {
      "id": "q-93-5",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الضحى ٩٣:٥",
      "surah": 93,
      "ayah": 5
    },
    {
      "id": "q-94-5",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا إِنَّ مَعَ الْعُسْرِ يُسْرًا",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة الشرح ٩٤:٥–٦",
      "surah": 94,
      "ayah": 5
    },
    {
      "id": "q-97-1",
      "type": "verse",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة القدر ٩٧:١–٣",
      "surah": 97,
      "ayah": 1
    },
    {
      "id": "q-97-5",
      "type": "verse",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "سَلَامٌ هِيَ حَتَّىٰ مَطْلَعِ الْفَجْرِ",
      "translatorLabel": null,
      "reference": "القرآن الكريم · سورة القدر ٩٧:٥",
      "surah": 97,
      "ayah": 5
    },
    {
      "id": "h-bukhari-38",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "مَنْ صَامَ رَمَضَانَ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ",
      "reference": "حديث شريف · صحيح البخاري ٣٨",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-37",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "مَنْ قَامَ رَمَضَانَ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ",
      "reference": "حديث شريف · صحيح البخاري ٣٧",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1901",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "مَنْ قَامَ لَيْلَةَ الْقَدْرِ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ",
      "reference": "حديث شريف · صحيح البخاري ١٩٠١",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1899",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "إِذَا دَخَلَ شَهْرُ رَمَضَانَ فُتِّحَتْ أَبْوَابُ السَّمَاءِ، وَغُلِّقَتْ أَبْوَابُ جَهَنَّمَ، وَسُلْسِلَتِ الشَّيَاطِينُ",
      "reference": "حديث شريف · صحيح البخاري ١٨٩٩",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1896",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "إِنَّ فِي الْجَنَّةِ بَابًا يُقَالُ لَهُ الرَّيَّانُ، يَدْخُلُ مِنْهُ الصَّائِمُونَ يَوْمَ الْقِيَامَةِ، لَا يَدْخُلُ مِنْهُ أَحَدٌ غَيْرُهُمْ",
      "reference": "حديث شريف · صحيح البخاري ١٨٩٦",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1904",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "لِلصَّائِمِ فَرْحَتَانِ يَفْرَحُهُمَا: إِذَا أَفْطَرَ فَرِحَ، وَإِذَا لَقِيَ رَبَّهُ فَرِحَ بِصَوْمِهِ",
      "reference": "حديث شريف · صحيح البخاري ١٩٠٤",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1894",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "يَتْرُكُ طَعَامَهُ وَشَرَابَهُ وَشَهْوَتَهُ مِنْ أَجْلِي، الصِّيَامُ لِي، وَأَنَا أَجْزِي بِهِ",
      "reference": "حديث قدسي · صحيح البخاري ١٨٩٤",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1902",
      "type": "hadith",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "كَانَ النَّبِيُّ ﷺ أَجْوَدَ النَّاسِ بِالْخَيْرِ، وَكَانَ أَجْوَدُ مَا يَكُونُ فِي رَمَضَانَ حِينَ يَلْقَاهُ جِبْرِيلُ",
      "reference": "حديث شريف · صحيح البخاري ١٩٠٢",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1923",
      "type": "hadith",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "تَسَحَّرُوا فَإِنَّ فِي السَّحُورِ بَرَكَةً",
      "reference": "حديث شريف · صحيح البخاري ١٩٢٣",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1957",
      "type": "hadith",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "لَا يَزَالُ النَّاسُ بِخَيْرٍ مَا عَجَّلُوا الْفِطْرَ",
      "reference": "حديث شريف · صحيح البخاري ١٩٥٧",
      "grade": "sahih"
    },
    {
      "id": "h-tirmidhi-807",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "مَنْ فَطَّرَ صَائِمًا كَانَ لَهُ مِثْلُ أَجْرِهِ، غَيْرَ أَنَّهُ لَا يَنْقُصُ مِنْ أَجْرِ الصَّائِمِ شَيْئًا",
      "reference": "حديث شريف · جامع الترمذي ٨٠٧",
      "grade": "hasan sahih"
    },
    {
      "id": "h-tirmidhi-3513",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "اللَّهُمَّ إِنَّكَ عَفُوٌّ كَرِيمٌ تُحِبُّ الْعَفْوَ فَاعْفُ عَنِّي",
      "reference": "حديث شريف · جامع الترمذي ٣٥١٣",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-2017",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "تَحَرَّوْا لَيْلَةَ الْقَدْرِ فِي الْوِتْرِ مِنَ الْعَشْرِ الْأَوَاخِرِ مِنْ رَمَضَانَ",
      "reference": "حديث شريف · صحيح البخاري ٢٠١٧",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-2024",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "كَانَ النَّبِيُّ ﷺ إِذَا دَخَلَ الْعَشْرُ شَدَّ مِئْزَرَهُ، وَأَحْيَا لَيْلَهُ، وَأَيْقَظَ أَهْلَهُ",
      "reference": "حديث شريف · صحيح البخاري ٢٠٢٤",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-7405",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "أَنَا عِنْدَ ظَنِّ عَبْدِي بِي، وَأَنَا مَعَهُ إِذَا ذَكَرَنِي … وَإِنْ أَتَانِي يَمْشِي أَتَيْتُهُ هَرْوَلَةً",
      "reference": "حديث قدسي · صحيح البخاري ٧٤٠٥",
      "grade": "sahih"
    },
    {
      "id": "h-muslim-2759",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "إِنَّ اللَّهَ عَزَّ وَجَلَّ يَبْسُطُ يَدَهُ بِاللَّيْلِ لِيَتُوبَ مُسِيءُ النَّهَارِ، وَيَبْسُطُ يَدَهُ بِالنَّهَارِ لِيَتُوبَ مُسِيءُ اللَّيْلِ",
      "reference": "حديث شريف · صحيح مسلم ٢٧٥٩",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-1145",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "يَنْزِلُ رَبُّنَا كُلَّ لَيْلَةٍ إِلَى السَّمَاءِ الدُّنْيَا حِينَ يَبْقَى ثُلُثُ اللَّيْلِ الْآخِرُ، يَقُولُ: مَنْ يَدْعُونِي فَأَسْتَجِيبَ لَهُ … مَنْ يَسْتَغْفِرُنِي فَأَغْفِرَ لَهُ",
      "reference": "حديث شريف · صحيح البخاري ١١٤٥",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-6307",
      "type": "hadith",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "وَاللَّهِ إِنِّي لَأَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ فِي الْيَوْمِ أَكْثَرَ مِنْ سَبْعِينَ مَرَّةً",
      "reference": "حديث شريف · صحيح البخاري ٦٣٠٧",
      "grade": "sahih"
    },
    {
      "id": "h-tirmidhi-2499",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "كُلُّ ابْنِ آدَمَ خَطَّاءٌ، وَخَيْرُ الْخَطَّائِينَ التَّوَّابُونَ",
      "reference": "حديث شريف · جامع الترمذي ٢٤٩٩",
      "grade": "hasan"
    },
    {
      "id": "h-bukhari-6464",
      "type": "hadith",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "أَحَبُّ الْأَعْمَالِ أَدْوَمُهَا إِلَى اللَّهِ وَإِنْ قَلَّ",
      "reference": "حديث شريف · صحيح البخاري ٦٤٦٤",
      "grade": "sahih"
    },
    {
      "id": "h-bukhari-5999",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "اللَّهُ أَرْحَمُ بِعِبَادِهِ مِنْ هَذِهِ بِوَلَدِهَا",
      "reference": "حديث شريف · صحيح البخاري ٥٩٩٩",
      "grade": "sahih"
    },
    {
      "id": "h-muslim-233",
      "type": "hadith",
      "isEnabled": true,
      "weight": 2,
      "arabic": null,
      "translation": "الصَّلَوَاتُ الْخَمْسُ، وَالْجُمُعَةُ إِلَى الْجُمُعَةِ، وَرَمَضَانُ إِلَى رَمَضَانَ مُكَفِّرَاتٌ مَا بَيْنَهُنَّ إِذَا اجْتَنَبَ الْكَبَائِرَ",
      "reference": "حديث شريف · صحيح مسلم ٢٣٣",
      "grade": "sahih"
    },
    {
      "id": "h-tirmidhi-682",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "وَيُنَادِي مُنَادٍ: يَا بَاغِيَ الْخَيْرِ أَقْبِلْ، وَيَا بَاغِيَ الشَّرِّ أَقْصِرْ، وَلِلَّهِ عُتَقَاءُ مِنَ النَّارِ، وَذَلِكَ كُلَّ لَيْلَةٍ",
      "reference": "حديث شريف · جامع الترمذي ٦٨٢",
      "grade": "sahih"
    },
    {
      "id": "h-tirmidhi-3545",
      "type": "hadith",
      "isEnabled": true,
      "weight": 1,
      "arabic": null,
      "translation": "رَغِمَ أَنْفُ رَجُلٍ دَخَلَ عَلَيْهِ رَمَضَانُ ثُمَّ انْسَلَخَ قَبْلَ أَنْ يُغْفَرَ لَهُ",
      "reference": "حديث شريف · جامع الترمذي ٣٥٤٥",
      "grade": "hasan sahih"
    },
    {
      "id": "h-nasai-2106",
      "type": "hadith",
      "isEnabled": true,
      "weight": 3,
      "arabic": null,
      "translation": "أَتَاكُمْ رَمَضَانُ شَهْرٌ مُبَارَكٌ … لِلَّهِ فِيهِ لَيْلَةٌ خَيْرٌ مِنْ أَلْفِ شَهْرٍ، مَنْ حُرِمَ خَيْرَهَا فَقَدْ حُرِمَ",
      "reference": "حديث شريف · سنن النسائي ٢١٠٦",
      "grade": "sahih"
    }
  ]
}
